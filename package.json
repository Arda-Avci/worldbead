{
  "name": "worldbead",
  "version": "1.0.0",
  "description": "WorldBead: Pop the Planets - 3D bead-shooter where the sphere evolves into Earth, then the Moon, Venus, Mars and beyond.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && cap sync",
    "android:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "keywords": [
    "game",
    "threejs",
    "capacitor"
  ],
  "author": "Arda Avci",
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
